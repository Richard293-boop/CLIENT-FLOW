# ==============================================================================
# ClientFlow Front-End Environment Variables (Vite)
# ==============================================================================
# These are exposed in the browser bundle (public anon key only).
# The service role key and Resend API key must NEVER be placed here.

# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://[your-project-ref].supabase.co"

# Your Supabase Anonymous Public Key (Project Settings -> API -> anon/public)
VITE_SUPABASE_ANON_KEY="[your-supabase-anon-key]"

# ==============================================================================
# Supabase Edge Functions Secrets (Set in Supabase CLI or Dashboard)
# Run: supabase secrets set KEY=VALUE
# ==============================================================================
# RESEND_API_KEY="re_[your-resend-api-key]"
# FROM_EMAIL="[from email]"          # e.g., updates@yourdomain.com
# SITE_URL="[site URL]"              # e.g., clientflow.work (without https://)
# CONTACT_EMAIL="[contact email]"    # e.g., support@clientflow.work
# SUPABASE_URL (Injected automatically by Supabase into Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY (Injected automatically by Supabase into Edge Functions)
